#!/usr/bin/env python3
"""vim-daily-gate - short hourly vim drills, monospaced-art flavoured.

History
  2026-09-14a  Rewritten in bash. The original fired only in a login shell
               outside tmux, which with auto-attach meant ~never.
  2026-09-14b  No instruction text may contain the word a motion targets; the
               editor opens with the cursor already parked on the edit.
  2026-09-15   Failure output gained an expected-vs-actual column diff.
  2026-09-18   Rewritten in Python. Reasons the bash version could not grow:
               * drills were a `case` statement, so every new exercise meant
                 editing the runner. They are now data (curriculum.json).
               * a drill could only ever be one line, which ruled out the
                 frame/rectangle work that monospaced art actually consists of.
               * there was no record of WHAT WAS TYPED, only of the final line,
                 so a failure could not say which keystroke went wrong.
               Added: hourly cadence, streak counter, paradigm-level concept
               text per drill, 16 drills across 3 tiers, blockwise/macro/ex
               frame drills, and a typed-vs-recipe keystroke table on failure.

Usage
  vim-daily-gate                 run a drill if one is due
  vim-daily-gate --if-due        same, but exit 0 silently when nothing is due
  vim-daily-gate --force         run the next project card regardless of cap/cooldown
  vim-daily-gate --card M0.01    run one available project card
  vim-daily-gate --tree          skill tree, project progress, and next card
                                 (interactive dashboard in a terminal; --tree --static = text)
  vim-daily-gate --dashboard     interactive journey dashboard (Textual venv from install.sh)
  vim-daily-gate --project M0    print the persistent strip for one module
  vim-daily-gate --preview M0    play/inspect the verified module strip
  vim-daily-gate --drill N|ID    run a specific drill
  vim-daily-gate --list          list the 88 project cards
  vim-daily-gate --legacy-list   list the original 46 recipe drills
  vim-daily-gate --due-quiet     exit 0 if a drill is due, 1 if not, no output
  vim-daily-gate --status        progress, streak and per-skill mastery
  vim-daily-gate --feedback      list the messages sent with f from lesson screens
  vim-daily-gate --learned       every command you have learned, with examples
  vim-daily-gate --deck [NAME]   flashcard deck: memory anchor, shape and diagram per command
  vim-daily-gate --quiz [N]      drill N deck items (default 5): missed first, then due, then new
  vim-daily-gate --deck-miss ID  mark deck items (e.g. DK.G.01) as missed so they come back soon
  vim-daily-gate --streak        one line: the current streak
  vim-daily-gate --concepts [N]  print the paradigm chapters (the "why")
  vim-daily-gate --quiz CONCEPT  the original multiple-choice + key-order question banks

Environment
  VIM_DAILY_SKIP=1          bypass entirely for this shell
  VIM_DAILY_NO_WARMUP=1     no deck warm-up before the first lesson of the day
  VIM_DAILY_TARGET=12       drills per day
  VIM_DAILY_COOLDOWN=900    seconds between prompts (default: every 15 minutes)
  VIM_DAILY_MAX_TRIES=3     attempts before the gate lets you through anyway
  VIM_DAILY_CURRICULUM      path to an alternate legacy curriculum.json
  VIM_DAILY_CURRICULUM_V2   path to an alternate curriculum-v2.json
  VIM_DAILY_CLEAN=1         opt into isolated Neovim with fallback tutor UI
  VIM_DAILY_USE_USER_CONFIG=0 opt out of the personal config (same as clean)
"""

import datetime as dt
import difflib
import importlib.util
import json
import os
import random
import re
import subprocess
import sys
from pathlib import Path

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "vim-daily")
SHARE = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")), "vim-daily")
CURRICULUM = os.environ.get("VIM_DAILY_CURRICULUM", os.path.join(SHARE, "curriculum.json"))
PROGRESS = os.path.join(STATE, "progress.json")
STAMP = os.path.join(STATE, "last-prompt")

TARGET = int(os.environ.get("VIM_DAILY_TARGET", "12"))
COOLDOWN = int(os.environ.get("VIM_DAILY_COOLDOWN", "900"))
MAX_TRIES = int(os.environ.get("VIM_DAILY_MAX_TRIES", "3"))
EDITOR = os.environ.get("EDITOR", "nvim")

MARKER = ">>>>>>>>>>  edit below this line, nothing above it  <<<<<<<<<<"

BOLD, DIM, OFF = "\033[1m", "\033[2m", "\033[0m"
GREEN, RED, YELLOW = "\033[32m", "\033[31m", "\033[33m"
if not sys.stdout.isatty():
    BOLD = DIM = OFF = GREEN = RED = YELLOW = ""


# =========================================================================
# keys - decode what was actually typed, and compare it to the recipe
# Vendorable on its own: takes bytes, returns readable vim key tokens.
# =========================================================================

_CSI = {b"A": "<Up>", b"B": "<Down>", b"C": "<Right>", b"D": "<Left>",
        b"H": "<Home>", b"F": "<End>"}


_MODBITS = ((0x01, "S-"), (0x02, "C-"), (0x04, "A-"), (0x08, "M-"))


def _apply_mod(mod, tok):
    if not mod:
        return tok
    inner = tok[1:-1] if tok.startswith("<") and tok.endswith(">") else tok
    return "<" + mod + inner + ">"


def decode_keylog(raw: bytes):
    """Turn nvim's -w scriptout into readable key tokens."""
    out, i, n, mod = [], 0, len(raw), ""
    while i < n:
        b = raw[i]
        if b == 0x80 and i + 2 < n and raw[i + 1] == 0xFC:
            # K_SPECIAL KS_MODIFIER <mask>: a modifier applied to the NEXT key.
            # This is how nvim reports Esc-followed-immediately-by-a-key, which
            # it folds into Meta (verified 2026-09-18: Esc then 0 with no gap
            # logs 80 fc 08 30 = <M-0>). Dropping it silently printed a bare
            # "0" in the table and made a real failure unexplainable.
            mod = "".join(name for bit, name in _MODBITS if raw[i + 2] & bit)
            i += 3
            continue
        if b == 0x1B:                                  # ESC, or an escape seq
            if i + 2 < n and raw[i + 1:i + 2] == b"[":
                j = i + 2
                while j < n and raw[j:j + 1] in b"0123456789;":
                    j += 1
                if j < n:
                    out.append(_apply_mod(mod, _CSI.get(raw[j:j + 1], "<Esc-seq>")))
                    mod = ""
                    i = j + 1
                    continue
            out.append(_apply_mod(mod, "<Esc>"))
        elif b == 0x0D:
            out.append(_apply_mod(mod, "<CR>"))
        elif b == 0x0A:
            out.append(_apply_mod(mod, "<NL>"))
        elif b == 0x09:
            out.append(_apply_mod(mod, "<Tab>"))
        elif b in (0x08, 0x7F):
            out.append(_apply_mod(mod, "<BS>"))
        elif b == 0x80:
            # Any other K_SPECIAL triple. nvim injects these itself during f/r/.
            # handling (verified 2026-09-18: `f.;` logs 66 2e 80 fd 35 3b). They
            # are not keys the human pressed, so they stay out of the table.
            i += 3
            continue
        elif b < 0x20:
            out.append(_apply_mod(mod, "<C-%s>" % chr(0x60 + b)))
        elif b < 0x7F:
            out.append(_apply_mod(mod, chr(b)))
        elif 0xC2 <= b <= 0xF4:
            # A UTF-8 lead byte.  Neovim escapes a literal 0x80 continuation
            # byte inside scriptout as K_SPECIAL KS_SPECIAL KE_FILLER
            # (80 FE 58).  U+2022 BULLET therefore logs E2 80 FE 58 A2 rather
            # than contiguous E2 80 A2.  Reassemble the scalar before decoding;
            # a later 80 FD 35 remains an injected key marker handled above.
            n_cont = 1 if b < 0xE0 else (2 if b < 0xF0 else 3)
            encoded, j = bytearray([b]), i + 1
            while len(encoded) < 1 + n_cont and j < n:
                if (raw[j] == 0x80 and j + 2 < n
                        and raw[j + 1:j + 3] == b"\xfeX"):
                    encoded.append(0x80)
                    j += 3
                else:
                    encoded.append(raw[j])
                    j += 1
            out.append(_apply_mod(mod, bytes(encoded).decode("utf-8", "replace")))
            mod = ""
            i = j
            continue
        else:
            out.append(_apply_mod(mod, raw[i:i + 1].decode("utf-8", "replace")))
        mod = ""
        i += 1
    return out


def tokenize(spec: str):
    """Split a recipe key-string into the same tokens decode_keylog emits."""
    out, i, n = [], 0, len(spec)
    while i < n:
        if spec[i] == "<":
            m = re.match(r"<(?:[A-Za-z]-)?[A-Za-z0-9]+>", spec[i:])
            if m:
                out.append(m.group(0))
                i += len(m.group(0))
                continue
        out.append(spec[i])
        i += 1
    return out


_SAVE_EX = {"w", "wq", "wq!", "x", "x!", "q", "q!", "qa", "wqa"}


def strip_save_tail(toks):
    """Drop a trailing save command so :wq vs ZZ is never reported as an error."""
    t = list(toks)
    for _ in range(4):
        if len(t) >= 2 and t[-2] == "Z" and t[-1] in ("Z", "Q"):
            t = t[:-2]
            continue
        if t and t[-1] == "<CR>":
            try:
                k = len(t) - 1 - t[::-1].index(":", 1)
            except ValueError:
                break
            if "".join(t[k + 1:-1]) in _SAVE_EX:
                t = t[:k]
                continue
        break
    return t


def keystroke_table(typed, expected, width=34):
    """Two columns: what you did, next to what the recipe asked for."""
    a, b = strip_save_tail(typed), strip_save_tail(expected)
    if not a and not b:
        return ["  (no keystrokes recorded)"]
    rows = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        mine, theirs = "".join(a[i1:i2]), "".join(b[j1:j2])
        if tag == "equal":
            rows.append((mine, theirs, "ok", DIM))
        elif tag == "replace":
            rows.append((mine, theirs, "not this", RED))
        elif tag == "delete":
            rows.append((mine, "", "extra", YELLOW))
        else:
            rows.append(("", theirs, "you skipped this", RED))
    lines = ["  %-*s  %-*s  %s" % (width, "YOU TYPED", width, "THE RECIPE ASKS FOR", ""),
             "  %s  %s  %s" % ("-" * width, "-" * width, "-" * 16)]
    shown = 0
    for mine, theirs, note, colour in rows:
        while mine or theirs or note:
            lines.append("  %s%-*s  %-*s  %s%s" % (
                colour, width, mine[:width], width, theirs[:width], note, OFF))
            mine, theirs, note = mine[width:], theirs[width:], ""
            shown += 1
            if shown > 40:
                return lines + ["  ... (truncated)"]
    return lines


# =========================================================================
# progress - streak, per-drill mastery, and which drill comes next
# Vendorable on its own: reads the log directory, returns plain dicts.
# =========================================================================

def day_log(day):
    return os.path.join(STATE, "%s.log" % day)


def day_counts():
    """{date: passes} for every day the gate has ever recorded.

    Skip and let-through rows (result=*) are visible in the ledger and in
    --export-progress, but they earn nothing: no cap credit, no streak.
    """
    counts = {}
    if not os.path.isdir(STATE):
        return counts
    for name in os.listdir(STATE):
        m = re.fullmatch(r"(\d{4}-\d{2}-\d{2})\.log", name)
        if not m:
            continue
        try:
            with open(os.path.join(STATE, name)) as f:
                n = sum(1 for line in f if line.strip() and "result=" not in line)
        except OSError:
            n = 0
        if n:
            counts[dt.date.fromisoformat(m.group(1))] = n
    return counts


def streaks(counts, today=None):
    """(current, longest, total_days, total_drills).

    The current streak is measured back from today, or from yesterday when
    today is still empty, so it does not read as broken before your first
    drill of the day.
    """
    today = today or dt.date.today()
    if not counts:
        return 0, 0, 0, 0
    anchor = today if counts.get(today) else today - dt.timedelta(days=1)
    cur, d = 0, anchor
    while counts.get(d):
        cur += 1
        d -= dt.timedelta(days=1)
    longest, run, prev = 0, 0, None
    for d in sorted(counts):
        run = run + 1 if prev and (d - prev).days == 1 else 1
        longest = max(longest, run)
        prev = d
    return cur, max(longest, cur), len(counts), sum(counts.values())


def load_progress(drills):
    by_id = {d["id"] for d in drills}
    p = None
    if os.path.exists(PROGRESS):
        try:
            with open(PROGRESS) as f:
                p = json.load(f)
        except (OSError, ValueError):
            p = None
    if p is None:
        # First run: seed mastery from the logs the bash version already wrote,
        # keyed on the stable drill id, falling back to the recorded title.
        # Skip/let-through rows (result=*) never seeded a pass.
        p = {"schema": "vim-daily/progress@1", "drills": {}, "last_id": None}
        by_title = {d["title"]: d["id"] for d in drills}
        for name in sorted(os.listdir(STATE)) if os.path.isdir(STATE) else []:
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}\.log", name):
                continue
            with open(os.path.join(STATE, name)) as f:
                for line in f:
                    fields = dict(kv.split("=", 1) for kv in line.rstrip("\n").split("\t") if "=" in kv)
                    if "result" in fields:
                        continue
                    did = fields.get("id") or by_title.get(fields.get("drill", ""))
                    if did not in by_id:
                        continue
                    rec = p["drills"].setdefault(did, {"seen": 0, "passed": 0, "failed": 0, "last": None})
                    rec["passed"] += 1
                    rec["seen"] += 1
                    rec["last"] = fields.get("completed_at")
                    p["last_id"] = did
    # Prune renames: ids the curriculum no longer ships (e.g. counted-insert).
    for did in list(p.get("drills", {})):
        if did not in by_id:
            del p["drills"][did]
    if p.get("last_id") not in by_id:
        p["last_id"] = None
    return p


def save_progress(p):
    os.makedirs(STATE, exist_ok=True)
    tmp = PROGRESS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(p, f, indent=1)
    os.replace(tmp, PROGRESS)


def unlocked(drills, tiers, total_drills):
    out = [d for d in drills
           if total_drills >= tiers.get(str(d.get("tier", 1)), {}).get("unlock_at", 0)]
    return out or [d for d in drills if d.get("tier", 1) == 1]


def pick_drill(drills, tiers, progress, total_drills):
    """Weakest skill first, failures weighted, recent drills excluded.

    Replaces the bash version's `day-of-year % 7`, which served the same two
    drills every day regardless of what you were bad at.
    """
    pool = unlocked(drills, tiers, total_drills)
    if len(pool) > 4:
        # Exclude the 3 most recently seen drills plus the last one served,
        # so back-to-back days stop feeling like repeats. Falls back to the
        # full pool rather than an empty one.
        drop = {progress.get("last_id")}
        seen = sorted(
            ((progress["drills"].get(d["id"], {}).get("last") or "", d["id"]) for d in pool),
            reverse=True)
        drop |= {did for last, did in seen[:3] if last}
        pool = [d for d in pool if d["id"] not in drop] or pool
    elif len(pool) > 1 and progress.get("last_id"):
        pool = [d for d in pool if d["id"] != progress["last_id"]] or pool
    def key(d):
        r = progress["drills"].get(d["id"], {})
        # Struggle ranks first: failures offset passes. Never-tried (0/0)
        # sorts above mastered, below anything you are failing at.
        return (r.get("passed", 0) - r.get("failed", 0), r.get("last") or "", random.random())
    return sorted(pool, key=key)[0]


def coverage(drills, progress):
    """(drills passed at least once, total drills)."""
    n = sum(1 for d in drills if progress["drills"].get(d["id"], {}).get("passed", 0) > 0)
    return n, len(drills)


def concept_mastery(drills, progress):
    """{concept: {passed, total}}, in curriculum order of first appearance."""
    out = {}
    for d in drills:
        cell = out.setdefault(d.get("concept", ""), {"passed": 0, "total": 0})
        cell["total"] += 1
        if progress["drills"].get(d["id"], {}).get("passed", 0) > 0:
            cell["passed"] += 1
    return out


def weakest_concept(drills, progress):
    best = None
    for name, cell in concept_mastery(drills, progress).items():
        if not cell["total"]:
            continue
        ratio = cell["passed"] / cell["total"]
        if best is None or ratio < best[1]:
            best = (name, ratio)
    return best[0] if best else ""


# =========================================================================
# quiz - multiple-choice and key-order questions per concept
# =========================================================================

QUESTIONS = {
    "grammar": [
        {"type": "mc", "q": "What does dd mean?",
         "choices": ["delete the current line", "delete one word",
                     "duplicate the current line", "change the current line"],
         "answer": 0,
         "why": "A doubled operator acts on the whole line: dd deletes it."},
        {"type": "keys", "q": "Delete the current line. What keys, in what order?",
         "answer": "dd",
         "why": "Verb doubled = linewise: dd."},
        {"type": "mc", "q": "In d2w, what job does the 2 do?",
         "choices": ["it is the verb", "it is the count: do it twice",
                     "it is the noun", "it deletes line 2"],
         "answer": 1,
         "why": "[count] [verb] [noun]: d-2-w deletes two words."},
        {"type": "mc", "q": "In yap, which key is the verb?",
         "choices": ["y", "a", "p", "all three at once"],
         "answer": 0,
         "why": "y yanks (verb); ap names the noun: around this paragraph."},
        {"type": "keys",
         "q": "Cursor anywhere inside double quotes. Change the quoted text. Keys, in what order?",
         "answer": 'ci"',
         "why": 'c (verb) + i" (noun): change inside the quotes.'},
        {"type": "mc", "q": "C is a contraction of which full sentence?",
         "choices": ["c$", "cc", "cl", "ciw"],
         "answer": 0,
         "why": "C changes to end of line: exactly c$."},
    ],
    "modes": [
        {"type": "mc", "q": "Single-letter commands like dd and yy live in which mode?",
         "choices": ["Insert", "Normal", "Visual", "Command-line"],
         "answer": 1,
         "why": "Normal mode frees the whole alphabet for commands."},
        {"type": "keys", "q": "You are in Insert mode. Get back to Normal mode. Keys?",
         "answer": "<Esc>",
         "why": "<Esc> returns to Normal mode."},
    ],
}


def do_quiz(cur, progress, want):
    if want not in QUESTIONS:
        print("Quiz banks: %s" % ", ".join(sorted(QUESTIONS)))
        for name in sorted(QUESTIONS):
            print("  vim-drill --quiz %-8s (%d questions)" % (name, len(QUESTIONS[name])))
        if want:
            print("\nNo question bank for %r yet." % want)
        return 0
    if not sys.stdin.isatty():
        return 0
    bank = QUESTIONS[want]
    title = cur["concepts"].get(want, {}).get("title", want)
    print("%sQuiz: %s%s   (%d questions)" % (BOLD, title, OFF, len(bank)))
    score = 0
    for i, q in enumerate(bank, 1):
        print("\n%d. %s" % (i, q["q"]))
        if q["type"] == "mc":
            for j, ch in enumerate(q["choices"]):
                print("   %s) %s" % ("abcd"[j], ch))
            try:
                ans = input("   answer (a-%s): " % "abcd"[len(q["choices"]) - 1]).strip().lower()
            except (EOFError, KeyboardInterrupt):
                print()
                return 0
            right = ans == "abcd"[q["answer"]]
            want_s = "abcd"[q["answer"]] + ") " + q["choices"][q["answer"]]
        else:
            try:
                ans = input("   keys (recipe notation): ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                return 0
            right = ans == q["answer"] or ans.replace(" ", "") == q["answer"]
            want_s = q["answer"]
        if right:
            score += 1
            print("   %sright%s  %s" % (GREEN, OFF, q["why"]))
        else:
            print("   %snot quite: %s%s  %s" % (RED, want_s, OFF, q["why"]))
    print("\n%sScore: %d/%d%s" % (BOLD, score, len(bank), OFF))
    qr = progress.setdefault("quiz", {}).setdefault(want, {"best": 0, "last": None})
    qr["best"] = max(qr.get("best", 0), score)
    qr["total"] = len(bank)
    qr["last"] = dt.datetime.now().astimezone().isoformat()
    save_progress(progress)
    return 0


# =========================================================================
# lesson - render the buffer the drill is performed in
# =========================================================================

def _wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if len(line) + len(word) + 1 > width:
            out.append(line)
            line = word
        else:
            line = (line + " " + word).strip()
    if line:
        out.append(line)
    return out or [""]


def region_lines(drill):
    return list(drill["start"])


def write_lesson(path, drill, concept, progress_line):
    tgt = drill["target"]
    body = [
        "Vim drill - %s" % drill["title"],
        "Skill: %s" % drill["skill"],
        "%s" % progress_line,
        "",
        "=== WHY THIS EXISTS " + "=" * 52,
        concept["title"],
        "",
    ]
    body += ["  " + l for l in concept["paradigm"].split("\n")]
    body += [
        "",
        "=== WHAT THIS DRILL BUYS YOU " + "=" * 43,
        "  " + drill.get("buys", ""),
        "",
        "=== WHERE THIS SHAPE COMES FROM " + "=" * 40,
    ]
    body += ["  " + l for l in _wrap(drill.get("source", "unsourced"), 72)]
    body += [
        "",
        "=== DO THIS " + "=" * 60,
    ]
    for keys, desc in drill["recipe"]:
        body.append("  %-14s %s" % (keys, desc))
    body += ["", "=== KEYS WORTH KEEPING " + "=" * 49]
    body += ["  " + l for l in drill.get("keys", [])]
    body += ["", "=== READING THE RECIPE " + "=" * 50]
    body += [
        "  <CR> is the Enter key.  :wq<CR> means type :wq, then Enter.",
        "  <Esc> is Escape.  <BS> is Backspace.  <C-v> means hold Ctrl, press v.",
    ]
    body += [
        "",
        "Auto-pairing is off in this buffer, so what you type is what you get.",
        "STUCK?  :q!  then answer  n          Another drill any time:  vim-drill",
        "Read the WHY section any time with  gg  , come back with  G",
        "",
        "=== MAKE THE LINES UNDER THE MARKER LOOK EXACTLY LIKE THIS " + "=" * 14,
    ]
    body += ["  │" + l for l in tgt]
    body += ["", MARKER]
    start = len(body) + 1                     # 1-based line number of first editable line
    body += region_lines(drill)
    with open(path, "w") as f:
        f.write("\n".join(body) + "\n")
    return start


def read_region(path):
    with open(path) as f:
        lines = f.read().split("\n")
    if MARKER not in lines:
        return None
    region = lines[lines.index(MARKER) + 1:]
    while region and not region[-1].strip():
        region.pop()
    return region


def matches(region, target):
    if region is None:
        return False
    return [l.rstrip() for l in region] == [l.rstrip() for l in target]


def reset_region(path, drill, concept=None, progress_line=""):
    """Restore the editable region; rebuild the whole lesson if needed.

    When the marker line itself is gone there is no region to restore, so the
    full lesson is rewritten from the drill definition (concept required).
    Returns True when the lesson is usable again.
    """
    with open(path) as f:
        lines = f.read().split("\n")
    if MARKER not in lines:
        if concept is None:
            return False
        write_lesson(path, drill, concept, progress_line)
        return True
    head = lines[:lines.index(MARKER) + 1]
    with open(path, "w") as f:
        f.write("\n".join(head + region_lines(drill)) + "\n")
    return True


def show_diff(region, target):
    print("\n%sNot matching yet.%s" % (BOLD, OFF))
    if region is None:
        print("  The %s marker line is gone, so there is nothing to check." % "edit-below")
        print("  Retrying rebuilds the whole lesson, marker included.")
        return
    n = max(len(region), len(target))
    for i in range(n):
        want = target[i] if i < len(target) else None
        got = region[i] if i < len(region) else None
        if want is not None and got is not None and want.rstrip() == got.rstrip():
            print("  %s  ok   │%s%s" % (DIM, got, OFF))
            continue
        if want is None:
            print("  %s  extra line │%s%s" % (RED, got, OFF))
            continue
        if got is None:
            print("  %s  missing    │%s%s" % (RED, want, OFF))
            continue
        print("  %swanted │%s%s" % (RED, want, OFF))
        print("  %syours  │%s%s" % (RED, got, OFF))
        k = 0
        while k < min(len(want), len(got)) and want[k] == got[k]:
            k += 1
        print("         %s^ first difference at column %d" % (" " * k, k + 1))
        if k < len(want) and k < len(got):
            print("          wanted %r there, got %r" % (want[k], got[k]))
        elif len(got) < len(want):
            print("          that line is %d character(s) too short" % (len(want) - len(got)))
        else:
            print("          that line is %d character(s) too long" % (len(got) - len(want)))


# =========================================================================
# editor
# =========================================================================

NOPAIRS = ("vim.bo.autoindent=false;vim.bo.smartindent=false;vim.bo.cindent=false;"
           "vim.bo.indentexpr='';"
           "pcall(function() vim.b.minipairs_disable = true end) "
           "pcall(function() vim.b.autopairs_enabled = false end) "
           "pcall(function() vim.b.delimitMate_autoclose = 0 end)")


# Readability audit #6: the brief is a plain buffer, so headings, the NEW
# CONCEPT ALERT and taught command names get Neovim highlights (bold, using
# the user's colorscheme colours). Art rows start with "  │" and never match.
BRIEF_HIGHLIGHT_LUA = (
    r"local hw=vim.g.vim_daily_brief_win;"
    r"if hw and vim.api.nvim_win_is_valid(hw) then "
    r"local function hl(name,src) local ok,h=pcall(vim.api.nvim_get_hl,0,{name=src,link=false});"
    r"vim.api.nvim_set_hl(0,name,{fg=(ok and h and h.fg) or nil,bold=true}) end;"
    r"hl('VimDailyHeading','Title');hl('VimDailyAlert','DiagnosticWarn');hl('VimDailyKey','String');"
    r"vim.fn.matchadd('VimDailyHeading',[[^\u[[:upper:]/×,]\+\( [[:upper:]/×,]\+\)*]],10,-1,{window=hw});"
    r"vim.fn.matchadd('VimDailyAlert',[[^\(★\|REMEMBER\).*]],11,-1,{window=hw});"
    r"vim.fn.matchadd('VimDailyKey',[[^  \d\+\. \zs\S\+\( \S\+\)\?]],11,-1,{window=hw});"
    r"vim.wo[hw].breakindent=true;vim.wo[hw].breakindentopt='shift:2';"
    r"end"
)


def run_editor(path, start_line, cursor, keylog, brief=None, task=None, hint=None):
    """Open the lesson with the cursor parked on the edit and keystrokes logged.

    Auto-pairing is disabled FOR THIS BUFFER ONLY. This is a precaution, not a
    diagnosed fix: a 2026-09-15 failure blamed on mini.pairs did not reproduce
    when a real interactive nvim was driven in tmux. Do not cite it as a cause;
    the keystroke table below is the actual diagnostic.
    """
    try:
        os.unlink(keylog)          # -w appends, so start each attempt clean
    except OSError:
        pass
    env = dict(os.environ, VIM_DAILY_ACTIVE="1")
    base = os.path.basename(EDITOR)
    if base == "nvim":
        cmd = [EDITOR]
        use_user_config = (os.environ.get("VIM_DAILY_CLEAN") != "1"
                           and os.environ.get("VIM_DAILY_USE_USER_CONFIG") != "0")
        if not use_user_config:
            cmd += ["--clean", "-i", "NONE"]
        cmd.append("+lua " + NOPAIRS)
        # The isolated editor still needs to look and behave like a tutor, not
        # an empty `--clean` buffer. Keep the task and current mode visible in
        # the editing window and make the legacy-style cheat sheet available.
        task_label = (task or "Edit the art to match TARGET").replace("%", "%%")
        hint_label = (hint or "Use F1 for movement and editing help").replace("%", "%%")
        ui_lua = (
            # VD-28/VD-31/VD-33: the popup temporarily releases tmux's mouse
            # at session scope. A user config with mouse=a would still claim
            # drag events for Visual mode, so this tutor Neovim process also
            # leaves the mouse to the terminal. The learner's config files and
            # Neovim processes outside the popup remain untouched.
            "vim.o.mouse='';"
            "vim.o.laststatus=3;vim.o.showmode=false;"
            "_G.VimDailyMode=function() local m=vim.fn.mode(1);local t={n='NORMAL',no='OPERATOR',i='INSERT',"
            "ic='INSERT',ix='INSERT',v='VISUAL',V='VISUAL LINE',[string.char(22)]='VISUAL BLOCK',"
            "R='REPLACE',Rv='VIRTUAL REPLACE',c='COMMAND',cv='EX',t='TERMINAL'};"
            "return t[m] or t[m:sub(1,1)] or m:upper() end;"
            "vim.g.vim_daily_statusline=' TUTOR · %{v:lua.VimDailyMode()} · ART · F1 HELP · :WQ SUBMIT ';"
            "vim.o.statusline=vim.g.vim_daily_statusline;"
            "local aw=vim.api.nvim_get_current_win();vim.g.vim_daily_art_win=aw;"
            "vim.g.vim_daily_taskbar=" + json.dumps(
                " DO THIS · o NEW LINE BELOW · F1 HELP · %<" + task_label[:42]
                + ("…" if len(task_label) > 42 else ""),
                ensure_ascii=False) + ";vim.wo[aw].winbar=vim.g.vim_daily_taskbar;"
            "_G.VimDailyToggleHelp=function() local hw=vim.g.vim_daily_help_win;"
            "if hw and vim.api.nvim_win_is_valid(hw) then vim.api.nvim_win_close(hw,true);"
            "if vim.api.nvim_win_is_valid(aw) then vim.api.nvim_set_current_win(aw) end;return end;"
            "if vim.api.nvim_win_is_valid(aw) then vim.api.nvim_set_current_win(aw) end;"
            "local ls={'CHEAT SHEET · F1 closes','Esc  NORMAL mode','i/a  insert before/after','o  NEW LINE BELOW',"
            "'O  new line above · A end of line','v/V/C-v  select chars/lines/block','h j k l  move · 0 ^ $  line',"
            "'w b e  words · f/t  find · gg/G first/last','{count}{motion} repeats efficiently',"
            "'yy  copy line · p/P put below/above','r/R replace · u undo · C-r redo',"
            "':s/old/new/g line · :%s file','Ctrl-w w  switch task/art',':wq submit · :q! leave'," +
            json.dumps("HINT: " + hint_label[:76], ensure_ascii=False) + "};"
            "local hb=vim.api.nvim_create_buf(false,true);local hh=math.min(#ls,math.max(6,vim.o.lines-5));"
            "local ww=math.min(40,math.max(24,vim.o.columns-4));local rr=math.max(0,vim.o.lines-hh-3);"
            "hw=vim.api.nvim_open_win(hb,true,{relative='editor',row=rr,col=0,width=ww,height=hh,"
            "style='minimal',border='single',title=' CHEAT SHEET · F1 closes '});vim.g.vim_daily_help_win=hw;"
            "vim.bo[hb].buftype='nofile';vim.bo[hb].bufhidden='wipe';vim.bo[hb].swapfile=false;"
            "vim.bo[hb].modifiable=true;vim.api.nvim_buf_set_lines(hb,0,-1,false,ls);vim.bo[hb].modifiable=false;"
            "vim.wo[hw].number=false;vim.wo[hw].relativenumber=false;vim.wo[hw].signcolumn='no';vim.wo[hw].wrap=true;"
            "vim.wo[hw].winfixwidth=true;end;"
            "vim.keymap.set({'n','v'},'<F1>',_G.VimDailyToggleHelp,{silent=true});"
            "vim.keymap.set('i','<F1>','<Esc><Cmd>lua VimDailyToggleHelp()<CR>',{silent=true});"
            "_G.VimDailyInstallFallbackCoach=function() if vim.g.vim_daily_fallback_coach then return end;"
            "vim.g.vim_daily_fallback_coach=true;vim.g.vim_daily_motion_key='';"
            "vim.g.vim_daily_motion_count=0;vim.g.vim_daily_motion_time=0;"
            "_G.VimDailyMotion=function(k) local now=vim.uv.hrtime();"
            "if vim.g.vim_daily_motion_key==k and now-vim.g.vim_daily_motion_time<1000000000 then "
            "vim.g.vim_daily_motion_count=vim.g.vim_daily_motion_count+1 else "
            "vim.g.vim_daily_motion_key=k;vim.g.vim_daily_motion_count=1 end;vim.g.vim_daily_motion_time=now;"
            "if vim.g.vim_daily_motion_count>3 then vim.schedule(function() if vim.api.nvim_win_is_valid(aw) then "
            "local advice=(k=='k' and '[count]k or CTRL-U') or (k=='j' and '[count]j or CTRL-D') or "
            "(k=='h' and 'b/B/ge/gE/F/T/0') or 'w/W/e/E/f/t/$';"
            "vim.wo[aw].winbar=' HARDTIME · '..k..' BLOCKED · use '..advice;"
            "vim.defer_fn(function() if vim.api.nvim_win_is_valid(aw) then vim.wo[aw].winbar=vim.g.vim_daily_taskbar end end,3000) end end);"
            "return '<Ignore>' end;return k end;"
            "for _,k in ipairs({'h','j','k','l'}) do local motion=k;vim.keymap.set('n',k,function() return _G.VimDailyMotion(motion) end,"
            "{expr=true,noremap=true,silent=true}) end;end"
        )
        if not use_user_config:
            # Clean mode owns the fallback chrome because no personal theme,
            # lualine, WhichKey, or Hardtime is available there.
            cmd.append("+lua " + ui_lua)
            cmd.append("+lua VimDailyInstallFallbackCoach()")
        if use_user_config:
            # VD-12: LazyVim renders trailing spaces as `-` (listchars trail)
            # and leading spaces as `│` indent guides. Both are real art glyphs,
            # so `  \|/  ` displayed as `│ \|/--`. Turn them off for every tutor
            # window (art and brief) after plugins load; the user's other
            # settings are left alone. LazyVim's bufferline appears after
            # startup and, with splitkeep=screen, scrolled line 1 (the lesson
            # header, or the first art row) out of view; vd_top restores the
            # top whenever the cursor still fits on screen.
            art_lua = (
                "local artb=vim.api.nvim_get_current_buf();"
                # Lessons define f/F/t/T/;/, with native Vim's current-line
                # semantics. Flash's global multi-line character motions can
                # select a matching glyph in another animation frame. A
                # buffer-local nonrecursive mapping keeps the taught language
                # deterministic without changing the personal configuration
                # anywhere outside this tutor art buffer.
                "for _,k in ipairs({'f','F','t','T',';',','}) do "
                "vim.keymap.set({'n','x','o'},k,k,{buffer=artb,noremap=true,silent=true}) end;"
                "local function vd_plain() for _,w in ipairs(vim.api.nvim_list_wins()) do "
                "local b=vim.api.nvim_win_get_buf(w);vim.wo[w].list=false;"
                "vim.b[b].snacks_indent=false;vim.b[b].miniindentscope_disable=true;"
                "if b==artb then vim.bo[b].autoindent=false;vim.bo[b].smartindent=false;"
                "vim.bo[b].cindent=false;vim.bo[b].indentexpr='' end;"
                "pcall(function() vim.b[b].indent_blankline_enabled=false end) end;"
                "pcall(function() require('snacks').indent.disable() end) end;"
                "local function vd_top() for _,w in ipairs(vim.api.nvim_list_wins()) do "
                "if vim.api.nvim_win_get_config(w).relative=='' then "
                "local c=vim.api.nvim_win_get_cursor(w)[1];"
                "if c<=vim.api.nvim_win_get_height(w) then vim.api.nvim_win_call(w,function() "
                "vim.fn.winrestview({topline=1}) end) end end end end;"
                "vd_plain();vim.defer_fn(vd_plain,200);vim.defer_fn(vd_plain,600);"
                "vim.defer_fn(vd_top,250);vim.defer_fn(vd_top,700);"
                "vim.api.nvim_create_autocmd({'BufWinEnter','WinEnter'},{callback=vd_plain});"
                "vim.api.nvim_create_autocmd('WinResized',{callback=function() vim.schedule(vd_top) end})"
            )
            cmd.append("+lua " + art_lua)
            # LazyVim's late window/buffer handlers can restore a remembered
            # cursor after the command-line +line/+normal placement. Cards
            # whose first operation is current-line f/t/C then edit the wrong
            # row while their key log still looks correct. Re-apply the
            # authored starting position once after VeryLazy, before headed
            # readiness, without changing any user mapping or global option.
            cursor_lua = (
                "do local aw=vim.api.nvim_get_current_win();local done=false;"
                "local function place() if done then return end;done=true;vim.defer_fn(function() "
                "if vim.api.nvim_win_is_valid(aw) then vim.api.nvim_win_set_cursor(aw,{%d,0});"
                "vim.api.nvim_win_call(aw,function() vim.cmd('normal! '..%s) end) end end,100) end;"
                "if vim.g.did_very_lazy then place() elseif package.loaded['lazy'] then "
                "vim.api.nvim_create_autocmd('User',{pattern='VeryLazy',once=true,callback=place}) "
                "else place() end end"
            ) % (start_line, json.dumps(cursor))
            cmd.append("+lua " + cursor_lua)
        if brief:
            # VD-09: keep instructions in a separate read-only buffer. The art
            # stays current, so gg/G, counts, ranges, and :t/:m address art only.
            brief_lua = (
                "local ls=vim.fn.readfile(%s);local aw=vim.api.nvim_get_current_win();"
                "local ab=vim.api.nvim_get_current_buf();"
                "local wide=vim.o.columns>=120;"
                # At 80x24 the personal tabline, both winbars, lualine, and the
                # command row consume enough screen rows that a six-row pose
                # lost its final TARGET row.  Give the compact brief one more
                # row while leaving the art window usable and scrollable.
                "local mh=(vim.o.lines<28) and math.max(11,math.floor(vim.o.lines*0.65)+1) or math.max(8,math.floor(vim.o.lines*0.55));"
                "if wide then local mw=math.min(84,math.max(58,math.floor(vim.o.columns*0.48)));"
                "vim.cmd('topleft '..mw..'vnew') else "
                "vim.cmd('aboveleft '..math.min(math.max(#ls+2,8),mh)..'new') end;"
                "local hw=vim.api.nvim_get_current_win();local hb=vim.api.nvim_get_current_buf();"
                "vim.bo[hb].buftype='nofile';vim.bo[hb].bufhidden='wipe';vim.bo[hb].swapfile=false;"
                "vim.api.nvim_buf_set_lines(hb,0,-1,false,ls);vim.bo[hb].modifiable=false;"
                "vim.wo[hw].number=false;vim.wo[hw].relativenumber=false;vim.wo[hw].signcolumn='no';"
                "vim.wo[hw].foldcolumn='0';if wide then vim.wo[hw].winfixwidth=true else vim.wo[hw].winfixheight=true end;"
                "vim.wo[hw].wrap=true;vim.wo[hw].linebreak=true;"
                "vim.wo[hw].winbar=' TASK · TARGET · HINT · CTRL-W W SWITCHES PANE ';"
                "vim.g.vim_daily_brief_win=hw;vim.g.vim_daily_art_win=aw;"
                "vim.api.nvim_set_current_win(aw);vim.wo[aw].wrap=false;"
                "vim.api.nvim_create_autocmd('BufWinLeave',{buffer=ab,once=true,callback=function()"
                "vim.schedule(function() if vim.api.nvim_win_is_valid(hw) then vim.cmd('qa!') end end) end})"
            ) % json.dumps(brief)
            cmd.append("+lua " + brief_lua)
            cmd.append("+lua " + BRIEF_HIGHLIGHT_LUA)
        ready_signal = os.environ.get("VIM_DAILY_TMUX_READY_SIGNAL")
        if ready_signal and os.environ.get("TMUX") and use_user_config:
            # Do not announce readiness until LazyVim has fired VeryLazy and
            # its event handlers (including Flash and user mappings) have had
            # a redraw window. If the personal config does not use lazy.nvim,
            # there is no VeryLazy contract to wait for.
            signal_lua = (
                "do local sent=false;local function signal() if sent then return end;sent=true;"
                "vim.defer_fn(function() local aw=vim.g.vim_daily_art_win;"
                "if aw and vim.api.nvim_win_is_valid(aw) then vim.api.nvim_set_current_win(aw) end;"
                "vim.fn.system({'tmux','wait-for','-U',%s}) end,300) end;"
                "if vim.g.did_very_lazy then signal() elseif package.loaded['lazy'] then "
                "vim.api.nvim_create_autocmd('User',{pattern='VeryLazy',once=true,callback=signal}) "
                "else signal() end end" % json.dumps(ready_signal)
            )
            cmd.append("+lua " + signal_lua)
        elif ready_signal and os.environ.get("TMUX"):
            # Live tmux regression tests wait on this event instead of racing
            # the isolated editor startup.
            signal_lua = (
                "vim.defer_fn(function() vim.fn.system({'tmux','wait-for','-U',%s}) end,100)"
                % json.dumps(ready_signal)
            )
            cmd.append("+lua " + signal_lua)
        cmd += ["+%d" % start_line, "+normal! " + cursor, "-w", keylog, path]
    elif base in ("vim", "vi", "view", "gvim", "mvim"):
        cmd = [EDITOR, "+silent! let b:delimitMate_autoclose = 0", "+%d" % start_line,
               "+normal! " + cursor, "-w", keylog, path]
    else:
        cmd = [EDITOR, path]
    subprocess.call(cmd, env=env)


# =========================================================================
# gate
# =========================================================================

def load_curriculum():
    path = CURRICULUM
    if not os.path.exists(path) and not os.environ.get("VIM_DAILY_CURRICULUM"):
        path = str(Path(__file__).resolve().parent.parent / "share" / "curriculum.json")
    with open(path) as f:
        return json.load(f)


def load_v2_runtime():
    """Load the project curriculum from the installed share symlink."""
    path = os.path.join(SHARE, "v2_runtime.py")
    if not os.path.exists(path):
        path = str(Path(__file__).resolve().parent.parent / "share" / "v2_runtime.py")
    spec = importlib.util.spec_from_file_location("vim_daily_v2_runtime", path)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load v2 runtime: %s" % path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def seconds_since_prompt():
    try:
        return int(dt.datetime.now().timestamp() - os.stat(STAMP).st_mtime)
    except OSError:
        return 999999


def progress_banner(counts, done_today):
    cur, best, days, total = streaks(counts)
    flame = "\U0001F525" if cur >= 3 else ""
    bits = ["%s%d/%d today%s" % (BOLD, done_today, TARGET, OFF),
            ("streak %s%d day%s%s %s" % (BOLD, cur, "" if cur == 1 else "s", OFF, flame)).rstrip(),
            "best %d" % best,
            "%d drill%s all time" % (total, "" if total == 1 else "s")]
    return "  ·  ".join(bits)


# VD-13 defect 6: set by main() for the v2 lesson route; hold_open() records
# an explicit request to continue with the next lesson in the same popup.
_OFFER_NEXT = False
_NEXT_REQUESTED = False
_RETRY_REQUESTED = False


def _collect_feedback(screen):
    """VD-43: route `f` on a result page to the runtime's feedback inbox."""
    v2 = _V2_RUNTIME.get("module")
    if v2 is None:
        print("feedback is unavailable on this page")
        return False
    return v2.collect_feedback(input, screen=screen)


_V2_RUNTIME = {}


def hold_open():
    """Keep a tmux popup on screen long enough to read it.

    `tmux display-popup -E` destroys the pane the moment the command exits, so
    without this the completion line and the keystroke table would flash past
    and vanish. The retry prompt already blocks; these are the exits that do not.
    """
    global _NEXT_REQUESTED, _RETRY_REQUESTED
    if not os.environ.get("VIM_DAILY_POPUP"):
        return

    prompt = ("\n%sEnter = close  ·  r = repeat this lesson  ·  n = next lesson\n"
              "f = feedback (tell us what is wrong)  ·  d = dashboard%s "
              if _OFFER_NEXT else "\n%sEnter = close  ·  f = feedback (tell us what is wrong)%s ")
    while True:
        try:
            answer = input(prompt % (DIM, OFF))
        except (EOFError, KeyboardInterrupt):
            return
        # VD-43: send a message about what is wrong, then choose again.
        if answer.strip().lower() in ("f", "feedback") and _collect_feedback("lesson-end"):
            continue
        if answer.strip().lower() in ("f", "feedback"):
            continue
        # VD-58: open the interactive dashboard, then return to this page.
        if _OFFER_NEXT and answer.strip().lower() in ("d", "dashboard"):
            v2, cfg = _V2_RUNTIME.get("module"), _V2_RUNTIME.get("cfg")
            if v2 is not None and cfg is not None:
                cur = v2.load_curriculum(cfg.share)
                v2.open_dashboard(cfg, cur, v2.project(cur, v2.read_events(cfg)))
            continue
        break
    # VD-13 defect 6: a motivated learner may continue in the same popup.
    if _OFFER_NEXT and answer.strip().lower() in ("n", "next"):
        _NEXT_REQUESTED = True
    elif _OFFER_NEXT and answer.strip().lower() in ("r", "retry", "repeat"):
        _RETRY_REQUESTED = True


def clear_result_route():
    """Start a same-popup route without residue from a wrapped held prompt."""
    if sys.stdout.isatty():
        print("\033[2J\033[H", end="")


def signal_post_rendered():
    """Tell headed regression tests that the complete debrief is visible."""
    post_signal = os.environ.get("VIM_DAILY_TMUX_POST_SIGNAL")
    if post_signal and os.environ.get("TMUX"):
        subprocess.call(["tmux", "wait-for", "-U", post_signal],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def signal_feedback_rendered():
    """Tell headed regression tests that held feedback page one is visible."""
    feedback_signal = os.environ.get("VIM_DAILY_TMUX_FEEDBACK_SIGNAL")
    if feedback_signal and os.environ.get("TMUX"):
        subprocess.call(["tmux", "wait-for", "-U", feedback_signal],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def signal_question_rendered(_question, _order):
    """Tell headed tests that a complete multiple-choice prompt is visible."""
    question_signal = os.environ.get("VIM_DAILY_TMUX_QUESTION_SIGNAL")
    if question_signal and os.environ.get("TMUX"):
        subprocess.call(["tmux", "wait-for", "-U", question_signal],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def post_page_break():
    """Keep replay/teaching feedback visible before replacing it with progress."""
    if not os.environ.get("VIM_DAILY_POPUP"):
        return
    while True:
        try:
            # The preceding renderer already ends with a newline. An additional
            # blank row scrolls the result headline off an 80x24 popup.
            answer = input("%sEnter = skill-tree progress  ·  f = feedback%s " % (DIM, OFF))
        except (EOFError, KeyboardInterrupt):
            return
        if answer.strip().lower() in ("f", "feedback"):
            _collect_feedback("result")
            continue
        return


def record_completion(drill, attempts, counts, result=None):
    os.makedirs(STATE, exist_ok=True)
    today = dt.date.today().isoformat()
    row = ("completed_at=%s\tdrill=%s\tskill=%s\tconcept=%s\tid=%s\tattempts=%d" % (
        dt.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z"),
        drill["title"], drill["skill"], drill.get("concept", ""), drill["id"], attempts))
    if result is not None:
        row += "\tresult=%s" % result
    with open(day_log(today), "a") as f:
        f.write(row + "\n")


def do_drill(drill, cur, progress, counts, done_today):
    concept = cur["concepts"][drill["concept"]]
    lesson = os.path.join(STATE, "%s-%s.txt" % (dt.date.today().isoformat(), drill["id"]))
    keylog = os.path.join(STATE, "keys-%s.log" % drill["id"])
    banner = progress_banner(counts, done_today)
    start = write_lesson(lesson, drill, concept, "Concept: " + concept["title"])
    open(STAMP, "a").close()
    os.utime(STAMP, None)

    rec = progress["drills"].setdefault(drill["id"], {"seen": 0, "passed": 0, "failed": 0, "last": None})
    rec["seen"] += 1
    progress["last_id"] = drill["id"]

    tries = 0
    while True:
        tries += 1
        print("\n%sVim drill: %s%s   (skill: %s)" % (BOLD, drill["title"], OFF, drill["skill"]))
        print(banner)
        print("%sWhy: %s%s" % (DIM, concept["title"], OFF))
        print("Cursor starts on the edit. Quit any time with :q! then n.\n")

        run_editor(lesson, start, drill.get("cursor", "^"), keylog)
        region = read_region(lesson)

        if matches(region, drill["target"]):
            rec["passed"] += 1
            rec["last"] = dt.datetime.now().astimezone().isoformat()
            record_completion(drill, tries, counts)
            save_progress(progress)
            counts = day_counts()
            cur_s, best, _, total = streaks(counts)
            print("%sDrill complete: %s%s   %s" % (GREEN, drill["title"], OFF,
                                                   progress_banner(counts, counts.get(dt.date.today(), 0))))
            if cur_s > best - 1 and cur_s > 1:
                print("%sStreak extended to %d days.%s" % (GREEN, cur_s, OFF))
            print("%s%s%s" % (DIM, drill.get("buys", ""), OFF))
            print("%sthe why: vim-daily-gate --concepts %s%s" % (DIM, drill["concept"], OFF))
            hold_open()
            return 0

        rec["failed"] += 1
        save_progress(progress)
        show_diff(region, drill["target"])
        try:
            with open(keylog, "rb") as f:
                typed = decode_keylog(f.read())
        except OSError:
            typed = []
        print("\n%sWHAT YOU TYPED, NEXT TO THE RECIPE%s  %s(save command not compared)%s"
              % (BOLD, OFF, DIM, OFF))
        for line in keystroke_table(typed, tokenize(drill.get("expected", ""))):
            print(line)

        if tries >= MAX_TRIES:
            print("\nLetting you through after %d attempts. Retry later with: vim-drill" % tries)
            record_completion(drill, tries, counts, result="let-through")
            hold_open()
            return 0
        try:
            ans = input("\nRetry with fresh lines? [Y/n/k = keep my mess] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if ans in ("n", "no", "q"):
            record_completion(drill, tries, counts, result="skip")
            print("Skipped. Retry later with: vim-drill")
            hold_open()
            return 0
        if ans in ("", "y", "yes", "r", "reset"):
            reset_region(lesson, drill, concept, "Concept: " + concept["title"])
            print("Lines reset.")
        # k / keep: retry from the buffer exactly as you left it.


def is_due(done_today):
    if os.environ.get("VIM_DAILY_SKIP") or os.environ.get("VIM_DAILY_ACTIVE") or os.environ.get("NVIM"):
        return False
    if done_today >= TARGET:
        return False
    if seconds_since_prompt() < COOLDOWN:
        return False
    return True


def main(argv):
    os.makedirs(STATE, exist_ok=True)
    mode = argv[0] if argv else "run"

    # VD-09: V2 is the normal hourly route. The original 46 exact-recipe drills stay
    # available through --drill and --legacy-* while existing progress remains
    # untouched in progress.json and the dated logs.
    v2_modes = {"run", "--force", "--if-due", "--due-quiet", "--status", "--tree", "--dashboard", "--feedback", "--learned",
                "--list", "--export-progress", "--card", "--project", "--preview",
                "--deck", "--deck-miss"}
    # Memory plan 2026-09-29: `--quiz` or `--quiz N` drills the flashcard deck;
    # `--quiz NAME` still opens the original concept question bank.
    if mode == "--quiz" and (len(argv) < 2 or argv[1].isdigit()):
        v2_modes.add("--quiz")
    if mode in v2_modes:
        v2 = load_v2_runtime()
        _V2_RUNTIME["module"] = v2
        v2_share = SHARE
        if not os.path.exists(os.path.join(v2_share, "curriculum-v2.json")):
            v2_share = str(Path(__file__).resolve().parent.parent / "share")
        cfg = v2.RuntimeConfig(
            state=STATE, share=v2_share, editor=EDITOR, max_tries=MAX_TRIES,
            target=TARGET, cooldown=COOLDOWN, stamp=STAMP, run_editor=run_editor,
            decode_keylog=decode_keylog, hold_open=hold_open,
            colours=(BOLD, DIM, OFF, GREEN, RED, YELLOW),
            keystroke_table=keystroke_table, tokenize=tokenize,
            feedback_rendered=signal_feedback_rendered,
            post_page_break=post_page_break,
            post_rendered=signal_post_rendered,
            question_rendered=signal_question_rendered)
        _V2_RUNTIME["cfg"] = cfg  # VD-58: `d` on the held page opens the dashboard
        global _OFFER_NEXT, _NEXT_REQUESTED, _RETRY_REQUESTED
        _OFFER_NEXT = mode in ("run", "--force", "--if-due")
        result = v2.run(cfg, argv, force=(mode == "--force"))
        # VD-13 defect 6: "n" at the closing prompt starts the next due lesson
        # in the same popup. It is the learner's explicit request, so it uses
        # the on-demand (--force) route, like prefix+V; Enter still closes.
        practice_run = False
        while _OFFER_NEXT and (_NEXT_REQUESTED or _RETRY_REQUESTED) and result is not None:
            retry = _RETRY_REQUESTED
            _NEXT_REQUESTED = False
            _RETRY_REQUESTED = False
            if retry:
                card_id = getattr(v2, "LAST_RUN_CARD_ID", None)
                kind = getattr(v2, "LAST_RUN_KIND", None)
                if not card_id:
                    print("No lesson is available to repeat.")
                    break
                if practice_run or result == 0:
                    repeat_mode = "--practice-review" if kind == "review" else "--practice-card"
                    result = v2.run(cfg, [repeat_mode, card_id], force=True)
                    practice_run = True
                else:
                    # A failed ordinary card remains the module's current card;
                    # a failed review remains selected by the remediation queue.
                    repeat_args = ["--force"] if kind == "review" else ["--card", card_id]
                    result = v2.run(cfg, repeat_args, force=True)
                    practice_run = False
            else:
                if result != 0 and not practice_run:
                    clear_result_route()
                    print("The current lesson is not passed, so Next cannot skip it.")
                    print("Use r to repeat this lesson, or Enter to close.")
                    hold_open()
                    continue
                clear_result_route()
                result = v2.run(cfg, ["--continue"], force=False)
                practice_run = False
        if result is not None:
            finished_signal = os.environ.get("VIM_DAILY_TMUX_FINISHED_SIGNAL")
            # The client-attached hook probes with --due-quiet before opening
            # the popup. Test completion signals belong to the interactive
            # lesson, never to that probe.
            if finished_signal and mode != "--due-quiet" and os.environ.get("TMUX"):
                subprocess.call(["tmux", "wait-for", "-U", finished_signal],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return result

    legacy_aliases = {"--legacy-list": "--list", "--legacy-status": "--status",
                      "--legacy-export-progress": "--export-progress"}
    if mode in legacy_aliases:
        argv = [legacy_aliases[mode]] + argv[1:]
        mode = argv[0]

    cur = load_curriculum()
    drills, tiers = cur["drills"], cur.get("tiers", {})
    progress = load_progress(drills)
    counts = day_counts()
    today = dt.date.today()
    done_today = counts.get(today, 0)
    _, _, _, total = streaks(counts)

    if mode == "--list":
        for i, d in enumerate(drills):
            r = progress["drills"].get(d["id"], {})
            lock = "" if d in unlocked(drills, tiers, total) else "  (locked)"
            print("%2d  t%d  %-24s %-34s passed %d%s" % (
                i, d.get("tier", 1), d["title"], d["skill"], r.get("passed", 0), lock))
        return 0

    if mode == "--concepts":
        want = argv[1] if len(argv) > 1 else None
        for name, c in cur["concepts"].items():
            if want and want not in name:
                continue
            print("%s%s%s\n%s\n" % (BOLD, c["title"], OFF, c["paradigm"]))
        return 0

    if mode == "--streak":
        c, b, days, tot = streaks(counts)
        print("vim drills: streak %d day%s (best %d), %d today, %d all time"
              % (c, "" if c == 1 else "s", b, done_today, tot))
        return 0

    if mode == "--export-progress":
        c, b, days, tot = streaks(counts)
        npass, ntotal = coverage(drills, progress)
        json.dump({"schema": "vim-daily/export@1", "date": today.isoformat(),
                   "today": done_today, "target": TARGET, "streak": c, "longest_streak": b,
                   "active_days": days, "total_completed": tot,
                   "coverage": {"passed": npass, "total": ntotal},
                   "concepts": concept_mastery(drills, progress),
                   "quiz": progress.get("quiz", {}),
                   "drills": progress["drills"]}, sys.stdout, indent=1)
        print()
        return 0

    if mode == "--quiz":
        want = argv[1] if len(argv) > 1 else ""
        return do_quiz(cur, progress, want)

    if mode == "--status":
        c, b, days, tot = streaks(counts)
        print("%svim drills%s  %s" % (BOLD, OFF, progress_banner(counts, done_today)))
        print("active days: %d   cadence: every %ds, cap %d/day" % (days, COOLDOWN, TARGET))
        print("since last prompt: %ds" % seconds_since_prompt())
        npass, ntotal = coverage(drills, progress)
        print("coverage: %d/%d drills passed at least once (%d%%)  weakest concept: %s" % (
            npass, ntotal, (100 * npass // ntotal) if ntotal else 0,
            weakest_concept(drills, progress)))
        print("\n%-26s %-34s %s" % ("DRILL", "SKILL", "passed/failed"))
        for d in drills:
            r = progress["drills"].get(d["id"], {})
            mark = "" if d in unlocked(drills, tiers, total) else " (locked)"
            print("%-26s %-34s %d/%d%s" % (d["title"], d["skill"],
                                           r.get("passed", 0), r.get("failed", 0), mark))
        print("\n%-22s %s" % ("CONCEPT", "mastered"))
        for name, cell in concept_mastery(drills, progress).items():
            print("%-22s %d/%d" % (name, cell["passed"], cell["total"]))
        last14 = [today - dt.timedelta(days=i) for i in range(13, -1, -1)]
        print("\nlast 14 days  " + "".join("█" if counts.get(d) else "·" for d in last14))
        return 0

    forced = None
    if mode == "--drill":
        key = argv[1] if len(argv) > 1 else "0"
        forced = next((d for d in drills if d["id"] == key), None)
        if forced is None:
            try:
                forced = drills[int(key)]
            except (ValueError, IndexError):
                print("no such drill: %s" % key, file=sys.stderr)
                return 1
        mode = "--force"

    if mode == "--due-quiet":
        return 0 if is_due(done_today) else 1

    if mode != "--force":
        if not is_due(done_today):
            if mode == "--if-due":
                return 0
            print("No drill due. %d/%d done today. Force one with: vim-drill" % (done_today, TARGET))
            return 0

    if os.environ.get("TERM") == "dumb" or not sys.stdin.isatty() or not sys.stdout.isatty():
        return 0

    drill = forced or pick_drill(drills, tiers, progress, total)
    return do_drill(drill, cur, progress, counts, done_today)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
